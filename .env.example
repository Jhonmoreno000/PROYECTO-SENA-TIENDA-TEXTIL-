# D&D Textil - Variables de Entorno para Docker
# Copia este archivo como .env y ajusta los valores

# PostgreSQL
POSTGRES_DB=tienda_digital_textiles_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=mysecretpassword

# Backend (Java)
DB_URL=jdbc:postgresql://db:5432/tienda_digital_textiles_db
DB_USER=postgres
DB_PASSWORD=mysecretpassword

# Inicio de sesion con Google y Microsoft (opcional)
# El frontend los usa para abrir el inicio de sesion y el backend para verificar
# que cada token fue emitido para esta aplicacion. Sin ellos, el SSO queda deshabilitado.
VITE_GOOGLE_CLIENT_ID=
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=common
