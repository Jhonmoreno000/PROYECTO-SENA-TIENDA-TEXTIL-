# ==============================================================================
# D&D Textil - Variables de Entorno de Configuracion
# ==============================================================================
# Instrucciones:
# Copie este archivo como .env en la raiz del proyecto y ajuste los valores
# correspondientes a su entorno local o de despliegue en servidor.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base de Datos Relacional (PostgreSQL 17)
# ------------------------------------------------------------------------------
POSTGRES_DB=tienda_digital_textiles_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=mysecretpassword
DB_PORT=5432

# ------------------------------------------------------------------------------
# 2. Conectividad JDBC Backend Java
# ------------------------------------------------------------------------------
# Este valor solo se usa al ejecutar el backend fuera de Docker (desarrollo local).
# En Docker Compose la URL se fija automaticamente al servicio 'db' (ver docker-compose.yml).
DB_URL=jdbc:postgresql://localhost:5432/tienda_digital_textiles_db
DB_USER=postgres
DB_PASSWORD=mysecretpassword

# ------------------------------------------------------------------------------
# 3. Puertos de Servicios y Red
# ------------------------------------------------------------------------------
PORT=8081
BACKEND_PORT=8081
FRONTEND_PORT=3001
WS_PORT=8082

# ------------------------------------------------------------------------------
# 4. Seguridad y Politicas de CORS
# ------------------------------------------------------------------------------
# Origen permitido para solicitudes web del frontend (o '*' en entorno de desarrollo)
CORS_ALLOWED_ORIGIN=*

# Sesiones: vacío genera un secreto aleatorio por proceso e invalida sesiones al reiniciar.
# En producción configure un valor aleatorio largo para conservar sesiones entre reinicios.
SESSION_SECRET=

# ------------------------------------------------------------------------------
# 5. Pasarela de Pagos Wompi (Bancolombia) - Entorno Sandbox / Pruebas
# ------------------------------------------------------------------------------
# Llave publica (expuesta al navegador web para inicializar el widget de pago)
WOMPI_PUBLIC_KEY=pub_test_Q5yDA9xoKdePzhSGeVe9HAUr19rhZCQSQ

# Llave privada (solo backend, para autenticar operaciones directas)
WOMPI_PRIVATE_KEY=prv_test_V0Pq3O3wHqI0kO6vC4Q9Z7P6w2N5m8L1

# Secreto de integridad (firma criptografica SHA-256 de las transacciones)
WOMPI_INTEGRITY_SECRET=test_integrity_b0Xy0KqP3rI8zQ9x7W5m4V2n1L6s8F0d

# Secreto de eventos (firma de validacion de webhooks enviados por Wompi)
WOMPI_EVENTS_SECRET=test_events_j8K2m4N6p8Q0r2T4v6X8z0B2d4F6h8J0

# Entorno de ejecucion Wompi: 'sandbox' o 'production'
WOMPI_ENV=sandbox

# ------------------------------------------------------------------------------
# 6. Autenticacion Federada SSO (Google Cloud & Microsoft Entra ID) - Opcional
# ------------------------------------------------------------------------------
# Identificadores de cliente OAuth2 para validar tokens emitidos al frontend
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

AZURE_CLIENT_ID=
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=common
