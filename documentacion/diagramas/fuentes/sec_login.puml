@startuml sec_login
!include estilo.iuml
autonumber "<b>0."
title D&D Textil — Secuencia: iniciar sesión (CU-04)

actor "Usuario" as U
box "Frontend (React)" #F3F6FC
  participant "IniciarSesion.jsx" as UI
  participant "ContextoAutenticacion" as CTX
end box
box "Backend (Java)" #FBF7FA
  participant "ManejadorAutenticacion" as MA
  participant "ProtectorFuerzaBruta" as PFB
  participant "ServicioAutenticacion" as SA
  participant "JdbcRepositorioUsuarioImpl" as REPO
  participant "TokenSesion" as TK
end box
database "PostgreSQL" as DB

U -> UI : escribe correo y contraseña
UI -> CTX : login(email, password)
CTX -> MA : POST /api/iniciar-sesion\n{email, password}
activate MA
MA -> PFB : estaBloqueado(correo, IP)
alt 5 intentos fallidos previos
  MA --> CTX : 429 {error, segundos restantes}
  CTX --> UI : success = false
  UI --> U : "Cuenta bloqueada temporalmente"
end
MA -> SA : iniciarSesion(correo, contrasena)
activate SA
SA -> REPO : buscar usuario por correo
REPO -> DB : SELECT … FROM usuarios WHERE correo = ?
DB --> REPO : fila o vacío
SA -> SA : verifica la contraseña con PBKDF2\n(SHA-256 solo en cuentas antiguas)
alt credenciales incorrectas o cuenta suspendida
  SA --> MA : ExcepcionDominio
  MA -> PFB : registrarFallo(correo, IP)
  MA --> CTX : 400 {error}
  CTX --> UI : success = false
  UI --> U : "Credenciales incorrectas"
else credenciales válidas
  SA -> REPO : actualizarUltimoAcceso(id)
  SA --> MA : Usuario
  deactivate SA
  MA -> TK : emitir(idUsuario, rol)
  TK --> MA : token firmado HMAC-SHA256 (12 h)
  MA --> CTX : 200 {success, user, token}
  deactivate MA
  CTX -> CTX : guarda authUser y token\nen localStorage
  CTX --> UI : success = true
  UI -> UI : navega según rol\ncliente → /cliente · vendedor → /vendedor · admin → /admin
  UI --> U : panel de su rol
end

note over CTX, TK
  Las peticiones siguientes llevan Authorization: Bearer <token>.
  ManejadorBase verifica la firma y relee el rol en la base de datos.
  Con Google o Microsoft el flujo usa POST /api/autenticacion/sso.
end note
@enduml
