@startuml sec_compra
!include estilo.iuml
autonumber "<b>0."
title D&D Textil — Secuencia: realizar compra (CU-06)

actor "Cliente" as U
box "Frontend (React)" #F3F6FC
  participant "Carrito.jsx" as CAR
  participant "CheckoutForm\n(/checkout)" as CHK
  participant "Payment.jsx\n(/pago)" as PAY
end box
box "Backend (Java)" #FBF7FA
  participant "ManejadorPagosWompi" as MP
  participant "PagoWompiDAO" as DAO
end box
database "PostgreSQL" as DB

U -> CAR : "Continuar a Envío y Pago"
CAR -> CHK : navega a /checkout\n(no exige sesión)
U -> CHK : datos de quien recibe y dirección
CHK -> CHK : valida campos obligatorios
CHK -> PAY : continúa a /pago
U -> PAY : elige tarjeta, PSE,\nNequi / Bre-B o contraentrega
PAY -> MP : POST /api/pagos/intencion\n{items[idProducto, metros], cupón, envío}
activate MP
MP -> DAO : crearIntencionPago(...)
activate DAO
DAO -> DB : BEGIN
loop por cada artículo
  DAO -> DB : SELECT precio, stock FROM productos\nWHERE id = ? FOR SHARE (no descuenta)
  alt stock insuficiente
    DAO -> DB : ROLLBACK
    DAO --> MP : ExcepcionDominio
    MP --> PAY : 400 {error}
    PAY --> U : aviso de stock insuficiente
  end
end
DAO -> DAO : valida el cupón y calcula\ndescuento, envío, IVA 19 % y total
DAO -> DB : INSERT pedidos (estado 'pending', referencia_pago)\nINSERT items_pedido (precio congelado)
DAO -> DB : COMMIT
DAO --> MP : referencia y total
deactivate DAO
MP --> PAY : 200 {reference, amount}
deactivate MP
PAY -> PAY : procesarPagoDirecto()\naprueba el pago tras 0,8 s (simulado)
PAY -> MP : POST /api/pagos/confirmar\n{referencia DD-<13 dígitos>-XXXX, transaccionId, estado}
MP -> MP : contieneDatosTarjetaSensibles(cuerpo)
alt la referencia coincide con el patrón de tarjeta (comportamiento actual)
  MP --> PAY : 400 "Rechazado por seguridad PCI-DSS"
  note right of MP : el pedido queda en 'pending'
else diseño previsto
  MP -> DAO : confirmarPagoPorReferencia(...)
  DAO -> DB : SELECT … FROM pedidos WHERE referencia_pago = ?\nFOR UPDATE (idempotencia)
  DAO -> DB : UPDATE pedidos SET estado = 'paid',\npagado_en = NOW()
  DAO -> DB : UPDATE productos SET stock =\nGREATEST(0, stock − metros)
  MP --> PAY : 200
end
PAY -> PAY : vacía el carrito (no revisa la respuesta)
PAY --> U : /confirmacion?referencia=…\n"¡Pago Aprobado y Pedido Confirmado!"

note over PAY, DAO
  El pago es simulado: ningún medio se conecta a una pasarela real
  y la confirmación acepta el estado que envía el navegador.
  Hoy la confirmación falla siempre (defecto del filtro PCI, revisado el 17/11/2026),
  por eso el stock no se descuenta en las compras.
  El total sí lo recalcula el backend con los precios de la base de datos.
  Sin sesión, Payment.jsx envía userId = 4: el pedido queda a nombre de ese usuario.
end note
@enduml
