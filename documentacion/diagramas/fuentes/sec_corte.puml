@startuml sec_corte
!include estilo.iuml
autonumber "<b>0."
title D&D Textil — Secuencia: corte de un rollo textil

actor "Cliente HTTP\n(sin pantalla aún)" as C
box "Backend (Java)" #FBF7FA
  participant "ManejadorInventario" as MI
  participant "InventarioDAO" as DAO
  participant "ServicioCorteTextil" as S
  participant "RolloTextil" as R
end box
database "PostgreSQL" as DB

C -> MI : POST /api/inventario/corte\n{rollCode, meters, basePrice}
MI -> DAO : obtenerRolloPorCodigoOId(rollCode)
DAO -> DB : SELECT … FROM rollos_textil
DB --> DAO : rollo
DAO --> MI : RolloTextil
alt rollo no existe
  MI --> C : 404 {error}
else
  opt basePrice ≤ 0
    MI -> DB : SELECT precio FROM productos WHERE id = ?
    DB --> MI : precio (si no hay, 25 000)
  end

  == 1. Validar metraje continuo ==
  MI -> S : validarMetrajeContinuo([rollo], metros, lote)
  S -> R : getMetrajeRemanente()
  alt el rollo no alcanza
    S --> MI : FRAGMENTED_STOCK / INSUFFICIENT_STOCK
    MI --> C : 400 {error, code}
  else alcanza
    S --> MI : CORTE_CONTINUO_OK

    == 2. Procesar el corte ==
    MI -> S : procesarCorteYRemanente(rollo, metros, precio)
    S -> R : setMetrajeRemanente(remanente − metros)
    alt remanente = 0
      S -> R : setEstado("agotado")
    else 0 < remanente < 1,0 m
      S -> R : setEstado("retazo_liquidado")
      S -> S : new EventoMerma(remanente,\n"remanente_sub_metro")
    else remanente ≥ 1,0 m
      S -> R : setEstado("disponible")
    end
    S --> MI : ResultadoProcesamientoCorte

    == 3. Liquidar precio por volumen ==
    MI -> S : calcularPrecioEscalonado(precio, metros)
    S -> S : ≥ 50 m: ROLLO_CERRADO (−25 %)\n≥ 15 m: MAYORISTA (−15 %)\nresto: DETAL
    S --> MI : TarifaCalculada (totalNeto)

    MI -> DAO : actualizarRolloDespuesDeCorte(rollo, merma)
    DAO -> DB : transacción: UPDATE rollos_textil,\nINSERT eventos_merma (si hay retazo),\nUPDATE productos.stock
    DB --> DAO : ok
    MI --> C : 200 {rollId, remainingMeters,\nstatus, totalPrice}
  end
end

note over C, S
  El endpoint existe y usa el motor, pero ninguna pantalla del frontend lo llama todavía.
  El mismo servicio se prueba en PruebasReglasNegocioTextil.
end note
@enduml
