@startuml sec_factura
!include estilo.iuml
autonumber "<b>0."
title D&D Textil — Secuencia: descargar factura PDF (CU-26)

actor "Administrador\no Cliente" as U
box "Frontend (React)" #F3F6FC
  participant "FacturasAdmin.jsx /\nHistorialPedidos.jsx" as UI
end box
box "Backend (Java)" #FBF7FA
  participant "ManejadorFactura" as MF
  participant "PedidoDAO" as DAO
  participant "ServicioFactura\n(PDFBox)" as SF
end box
database "PostgreSQL" as DB

U -> UI : «Descargar factura» del pedido N
UI -> MF : GET /api/facturas/N
MF -> DAO : obtenerPedidoPorId(N)
DAO -> DB : SELECT … FROM pedidos WHERE id = N
DB --> DAO : pedido
DAO --> MF : Pedido
alt pedido no existe
  MF --> UI : 404 {error}
else
  MF -> DAO : obtenerCabeceraFactura(N)
  DAO -> DB : SELECT nombre_cliente, correo_cliente, direccion_envio,\nmetodo_pago, subtotal, monto_descuento, costo_envio,\nmonto_impuesto, documento_cliente FROM pedidos
  DB --> DAO : cabecera
  DAO --> MF : datos del cliente y montos guardados
  MF -> DAO : obtenerArticulosFactura(N)
  DAO -> DB : SELECT … FROM items_pedido\nLEFT JOIN productos WHERE pedido_id = N
  DB --> DAO : artículos
  DAO --> MF : lista de artículos
  MF -> MF : usa los montos guardados en el pedido;\nsi faltan: subtotal = Σ cantidad × precio,\nIVA = (subtotal − descuento) × 19 %
  MF -> SF : generarFactura(N, cliente, artículos, subtotal,\ndescuento, envío, IVA, total, método de pago)
  SF -> SF : encabezado con CUFE, datos del cliente,\ntabla de artículos, totales,\nvalor en letras, marca de agua
  SF --> MF : byte[] PDF
  MF --> UI : 200 application/pdf\nFAC-00000N.pdf
  UI --> U : descarga el archivo
end

note over MF, DB
  Todo se lee de las tablas en español (pedidos, items_pedido, productos).
  El manejador no comprueba el rol ni que el pedido sea del usuario que lo pide.
end note
@enduml
