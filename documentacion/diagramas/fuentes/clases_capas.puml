@startuml clases_capas
!include estilo.iuml
hide empty members
skinparam nodesep 25
skinparam ranksep 70
left to right direction
title D&D Textil — Diagrama de clases: arquitectura por capas del backend
package "infraestructura.api" #E8EEF9 {
  class ServidorApi {
    + {static} iniciarServidor(int) : void
  }
  abstract class ManejadorBase {
    - MAX_PETICIONES_POR_VENTANA = 120
    + handle(HttpExchange) : void
    # registrarLogJson(String, String, String, HttpExchange, int) : void
    # procesarPeticion(HttpExchange) : void
    # enviarRespuestaJson(HttpExchange, int, String) : void
    # enviarRespuestaError(HttpExchange, int, String) : void
    # obtenerParametroConsulta(HttpExchange, String) : String
  }
  interface HttpHandler <<JDK>>
  HttpHandler <|.. ManejadorBase
  class ManejadorArchivosEstaticos {
    .. rutas ..
    /uploads
  }
  ManejadorBase <|-- ManejadorArchivosEstaticos
  class ManejadorAutenticacion {
    .. rutas ..
    /api/iniciar-sesion
    /api/registro
  }
  ManejadorBase <|-- ManejadorAutenticacion
  class ManejadorCarrito {
    .. rutas ..
    /api/carrito
  }
  ManejadorBase <|-- ManejadorCarrito
  class ManejadorCarrusel {
    .. rutas ..
    /api/carrusel
  }
  ManejadorBase <|-- ManejadorCarrusel
  class ManejadorConfiguracion {
    .. rutas ..
    /api/configuracion
  }
  ManejadorBase <|-- ManejadorConfiguracion
  class ManejadorCupones {
    .. rutas ..
    /api/cupones
  }
  ManejadorBase <|-- ManejadorCupones
  class ManejadorFactura {
    .. rutas ..
    /api/facturas
  }
  ManejadorBase <|-- ManejadorFactura
  class ManejadorInventario {
    .. rutas ..
    /api/inventario
    /api/metricas
    /api/actividad
    /api/banner
  }
  ManejadorBase <|-- ManejadorInventario
  class ManejadorPedidos {
    .. rutas ..
    /api/pedidos
  }
  ManejadorBase <|-- ManejadorPedidos
  class ManejadorProductos {
    .. rutas ..
    /api/productos
  }
  ManejadorBase <|-- ManejadorProductos
  class ManejadorResenas {
    .. rutas ..
    /api/resenas
  }
  ManejadorBase <|-- ManejadorResenas
  class ManejadorSalud {
    .. rutas ..
    /health/live
    /health/ready
    /api/salud
  }
  ManejadorBase <|-- ManejadorSalud
  class ManejadorSeccionesInicio {
    .. rutas ..
    /api/secciones-inicio
  }
  ManejadorBase <|-- ManejadorSeccionesInicio
  class ManejadorSoporte {
    .. rutas ..
    /api/soporte
  }
  ManejadorBase <|-- ManejadorSoporte
  class ManejadorUsuarios {
    .. rutas ..
    /api/usuarios
  }
  ManejadorBase <|-- ManejadorUsuarios
  ServidorApi ..> ManejadorBase : registra rutas
}
package "aplicacion.servicios" #F6EAF3 {
