@startuml sec_registro
!include estilo.iuml
autonumber "<b>0."
title D&D Textil — Secuencia: registrarse (CU-03)

actor "Visitante" as U
box "Frontend (React)" #F3F6FC
  participant "Registro.jsx" as UI
  participant "ContextoAutenticacion" as CTX
end box
box "Backend (Java)" #FBF7FA
  participant "ManejadorAutenticacion" as MA
  participant "ServicioAutenticacion" as SA
  participant "JdbcRepositorioUsuarioImpl" as REPO
end box
database "PostgreSQL" as DB

U -> UI : nombre, correo, contraseña, confirmación\ny casilla de autorización de datos
UI -> UI : valida con zod\n(nombre ≥ 2, correo válido, clave ≥ 8,\nconfirmación igual, casilla marcada)
alt datos inválidos
  UI --> U : mensajes en el formulario
else datos válidos
  UI -> CTX : register(datos)
  CTX -> MA : POST /api/registro\n{name, email, password, aceptaHabeasData}
  MA -> MA : lee aceptaHabeasData\n(si no viene, queda en false)
  MA -> SA : registrarCliente(nombre, correo, contrasena, aceptaHabeasData)
  alt no acepta la política, faltan campos,\ncorreo inválido o clave < 8
    SA --> MA : ExcepcionDominio
    MA --> CTX : 400 {error}
    CTX --> UI : muestra el error
  else
    SA -> SA : rol = "cliente"\nhash PBKDF2 (10 000 iteraciones + sal)
    SA -> REPO : guardar(usuario, hash)
    REPO -> DB : INSERT INTO usuarios
    alt correo repetido (UNIQUE)
      DB --> REPO : error
      REPO --> SA : false
      SA --> MA : ExcepcionDominio("…el correo ya exista")
      MA --> CTX : 400 {error}
      CTX --> UI : muestra el error
    else
      DB --> REPO : ok
      REPO --> SA : true
      SA --> MA : ok
      MA --> CTX : 201 {success}
      CTX -> MA : login(correo, contraseña)\nPOST /api/iniciar-sesion
      MA --> CTX : 200 {usuario, token}
      CTX --> UI : sesión iniciada
      UI --> U : «¡Cuenta creada!» y redirige a Inicio (/)
    end
  end
end
note over UI, SA
  La autorización de datos (Ley 1581 de 2012) se pide en el formulario y el backend
  la exige; la fecha de aceptación no se guarda en la base de datos.
end note
@enduml
